
import discord
from discord import app_commands
from discord.ext import commands
TOKEN = 'MTQ3Njc3ODU2MTU0ODMyMDg3OA.GcIIDV.tWmxLRfmUDmKQAheBfK-hHo1VVUQ8vLTKu1U4E'
GUILD_ID = discord.Object(id=1475986376154677331)

class MyBot(commands.Bot):
    def __init__(self):
        super().__init__(command_prefix="!", intents=discord.Intents.default())
    
    async def setup_hook(self):
        self.tree.copy_global_to(guild=GUILD_ID)
        await self.tree.sync(guild=GUILD_ID)

bot = MyBot()  

@bot.tree.command(name="create_vca", description="Creates a new VCA document")
@app_commands.describe(
    item_number="The VCA number (e.g., 9999)",
    object_class="Safe, Euclid, Keter, etc.",
    description="Description of the anomaly"
)
async def create_vca(interaction: discord.Interaction, item_number: str, object_class: str, description: str):
    embed = discord.Embed(
        title=f"VCA-{item_number}",
        color=0x000000 # Black
    )
    embed.add_field(name="Item #", value=f"VCA-{item_number}", inline=False)
    embed.add_field(name="Object Class", value=object_class, inline=False)
    embed.add_field(name="Special Containment Procedures", value="[PENDING]", inline=False)
    embed.add_field(name="Description", value=description, inline=False)
    embed.set_footer(text="Foundation Secure Database")

    await interaction.response.send_message(embed=embed)

@bot.event
async def on_ready():
    print(f'Logged in as {bot.user} (ID: {bot.user.id})')

bot.run(MTQ3Njc3ODU2MTU0ODMyMDg3OA.GcIIDV.tWmxLRfmUDmKQAheBfK-hHo1VVUQ8vLTKu1U4E)
